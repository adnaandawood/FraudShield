# Copy to .env and adjust
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_CONSUMER_GROUP=fraud-processor-v1

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=frauddb
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraudpass
DATABASE_URL=postgresql+psycopg2://fraud:fraudpass@localhost:5433/frauddb

API_PORT=8000
MODEL_PATH=ml/model.pkl
RULE_WEIGHT=0.5
ML_WEIGHT=0.5
LOG_LEVEL=INFO
